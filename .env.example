# ===================================================================
# Placement Management System - Docker Environment Configuration
# Copy this template to .env and configure strong secrets.
# NEVER commit the actual .env file to source control.
# ===================================================================

# MySQL Container Settings
MYSQL_DATABASE=placement_management_system
MYSQL_USER=pms_user
MYSQL_PASSWORD=<set-strong-mysql-user-password>
MYSQL_ROOT_PASSWORD=<set-strong-mysql-root-password>
MYSQL_PORT=3307

# Spring Boot Application Settings
APP_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Schema Management for Local Docker Compose Testing
# Use 'update' to auto-create tables on a fresh local MySQL container.
# In production on AWS, this is strictly 'validate'.
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Mandatory JWT Secret: Base64-encoded HMAC-SHA256 key (minimum 256 bits / 32 bytes)
# Generate via PowerShell:
# [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
JWT_SECRET=<set-base64-256bit-secret-here>

# Web Frontend CORS Origins (comma-separated, without trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: Enable Swagger UI & OpenAPI Docs in Production Mode (defaults to false)
SWAGGER_ENABLED=false
API_DOCS_ENABLED=false